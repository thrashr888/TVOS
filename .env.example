# Database
DUCKDB_PATH=tvos.duckdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ZMQ
ZMQ_HOST=localhost
ZMQ_PULL_PORT=5555

# Weaviate
WEAVIATE_URL=http://localhost:8080

# LLM Configuration
# Provider options: openai, anthropic, gemini, mock
LLM_PROVIDER=mock

# API Keys (set the one matching your LLM_PROVIDER)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Model Configuration (optional - defaults to latest recommended models)
# OpenAI models: gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-4o

# Anthropic models: claude-3-5-sonnet-latest
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Gemini models: gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# External Connectors Configuration
# Generate a key with: python -c "from tvos.connectors import CredentialEncryption; print(CredentialEncryption.generate_key())"
CONNECTOR_ENCRYPTION_KEY=your-base64-encryption-key-here

# Gmail OAuth Configuration
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
